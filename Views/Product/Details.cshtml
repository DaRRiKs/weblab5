@model Product?

@{
    ViewData["Title"] = "Товар";
}

<h1>Товар</h1>

@if (Model is null)
{
    <div class="alert alert-danger">@(ViewBag.Error ?? "Товар не найден.")</div>
}
else
{
    <dl class="row">
        <dt class="col-sm-2">Id</dt><dd class="col-sm-10">@Model.Id</dd>
        <dt class="col-sm-2">Name</dt><dd class="col-sm-10">@Model.Name</dd>
        <dt class="col-sm-2">Description</dt><dd class="col-sm-10">@Model.Description</dd>
        <dt class="col-sm-2">Price</dt><dd class="col-sm-10">@Model.Price</dd>
        <dt class="col-sm-2">Quantity</dt><dd class="col-sm-10">@Model.Quantity</dd>
    </dl>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Изменить</a>
}

<a asp-action="Index" class="btn btn-secondary">К списку</a>
