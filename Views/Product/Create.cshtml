@model Product

@{
    ViewData["Title"] = "Добавить товар";
}

<h1>Добавить товар</h1>

@if (ViewBag.Error is not null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<form asp-action="Create" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Name" class="form-label">Название</label>
        <input asp-for="Name" class="form-control" required />
    </div>
    <div class="mb-3">
        <label asp-for="Description" class="form-label">Описание</label>
        <textarea asp-for="Description" class="form-control" required></textarea>
    </div>
    <div class="mb-3">
        <label asp-for="Price" class="form-label">Цена</label>
        <input asp-for="Price" type="number" step="0.01" min="0" class="form-control" required />
    </div>
    <div class="mb-3">
        <label asp-for="Quantity" class="form-label">Количество</label>
        <input asp-for="Quantity" type="number" min="0" class="form-control" required />
    </div>
    <button type="submit" class="btn btn-primary">Добавить</button>
    <a asp-action="Index" class="btn btn-secondary">К списку</a>
</form>
