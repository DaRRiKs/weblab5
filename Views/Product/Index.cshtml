@model IEnumerable<Product>

@{
    ViewData["Title"] = "Товары";
    var error = ViewBag.Error as string ?? TempData["Error"] as string;
}

<h1>Товары</h1>

@if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}

<p><a asp-action="Create" class="btn btn-primary">Добавить товар</a></p>

<form asp-action="Details" method="get" class="d-flex gap-2 mb-3">
    <input name="id" type="number" min="1" required class="form-control w-auto" placeholder="ID товара" />
    <button type="submit" class="btn btn-outline-secondary">Найти по ID</button>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Название</th>
            <th>Цена</th>
            <th>Количество</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var product in Model)
    {
        <tr>
            <td>@product.Id</td>
            <td>@product.Name</td>
            <td>@product.Price</td>
            <td>@product.Quantity</td>
            <td>
                <a asp-action="Details" asp-route-id="@product.Id" class="btn btn-sm btn-outline-primary">Подробнее</a>
                <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-outline-secondary">Изменить</a>
                <form asp-action="Delete" asp-route-id="@product.Id" method="post" class="d-inline" onsubmit="return confirm('Удалить товар?');">
                    <button type="submit" class="btn btn-sm btn-outline-danger">Удалить</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
